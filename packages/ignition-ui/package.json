{
  "name": "@nomicfoundation/ignition-ui",
  "version": "3.2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/NomicFoundation/hardhat",
    "directory": "packages/ignition-ui"
  },
  "scripts": {
    "predev": "pnpm regenerate-deployment-example",
    "dev": "vite --force",
    "build": "tsc --build .",
    "pretest": "pnpm build",
    "pretest:only": "pnpm build",
    "test": "node --import tsx/esm --test --test-reporter=@nomicfoundation/hardhat-node-test-reporter \"test/*.ts\" \"test/!(fixture-projects|helpers)/**/*.ts\"",
    "test:only": "node --import tsx/esm --test --test-only --test-reporter=@nomicfoundation/hardhat-node-test-reporter \"test/*.ts\" \"test/!(fixture-projects|helpers)/**/*.ts\"",
    "test:coverage": "c8 --reporter html --reporter text --all --exclude test --exclude \"src/**/{types,type-extensions}.ts\" --src src node --import tsx/esm --test --test-reporter=@nomicfoundation/hardhat-node-test-reporter \"test/*.ts\" \"test/!(fixture-projects|helpers)/**/*.ts\"",
    "regenerate-deployment-example": "node ./scripts/generate-example-deployment-json.js",
    "lint": "pnpm eslint && pnpm prettier --check",
    "lint:fix": "pnpm eslint --fix && pnpm prettier --write",
    "prettier": "prettier \"**/*.{ts,js,md,json}\"",
    "eslint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "preview": "vite preview",
    "clean": "rimraf ./dist ./tsconfig.node.tsbuildinfo ./tsconfig.tsbuildinfo ./vite.config.js ./vite.config.d.ts",
    "prepack": "pnpm build && vite build"
  },
  "files": [
    "dist/",
    "src/",
    "CHANGELOG.md",
    "README.md"
  ],
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@nomicfoundation/hardhat-node-test-reporter": "workspace:^3.1.0",
    "@nomicfoundation/ignition-core": "workspace:^3.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "c8": "^12.0.0",
    "eslint": "9.39.5",
    "mermaid": "^11.0.0",
    "prettier": "3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "react-tooltip": "^6.0.0",
    "rimraf": "^6.1.3",
    "styled-components": "^6.0.0",
    "svg-pan-zoom": "^3.6.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
