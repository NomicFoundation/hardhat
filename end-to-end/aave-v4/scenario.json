{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "Aave v4 fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "anaPerezGhiglia/aave-v4",
  "commit": "27c95eae18c60547933b6486774f816175e124f0",
  "packageManager": "yarn",
  "env": {
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "submodules": true,
  "preinstall": "./preinstall.sh",
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "compile sequence": {
        "runs": 9,
        "steps": {
          "reset files & cache": {
            "command": "git checkout -- tests/contracts/libraries/math/WadRayMath.t.sol tests/contracts/spoke/liquidation/Spoke.LiquidationCall.t.sol src/libraries/math/MathUtils.sol && forge clean",
            "measure": false
          },
          "cold compile": {
            "command": "forge build",
            "dependsOn": ["reset files & cache"]
          },
          "edit & compile Solidity test with min deps: tests/contracts/libraries/math/WadRayMath.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> tests/contracts/libraries/math/WadRayMath.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity test with max deps: tests/contracts/spoke/liquidation/Spoke.LiquidationCall.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> tests/contracts/spoke/liquidation/Spoke.LiquidationCall.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity contract: src/libraries/math/MathUtils.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> src/libraries/math/MathUtils.sol && forge build",
            "dependsOn": ["cold compile"]
          }
        }
      },
      "warm compile": {
        "runs": 117,
        "command": "forge build",
        "dependsOn": ["cold compile"]
      },
      "test solidity": {
        "runs": 9,
        "command": "forge test",
        "dependsOn": ["cold compile"]
      }
    }
  }
}
