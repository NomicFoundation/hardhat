{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "1inch SwapVM contract fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "anaPerezGhiglia/1inch-swap-vm",
  "commit": "7102f412db16aaf10dafa8dd40c4b85f99f0bb4e",
  "packageManager": "pnpm",
  "env": {
    "pnpm_config_block_exotic_subdeps": "false",
    "pnpm_config_dangerously_allow_all_builds": "true",
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "submodules": false,
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "compile sequence": {
        "runs": 9,
        "steps": {
          "reset files & cache": {
            "command": "git checkout -- test/ProtocolFeeProviderMock.t.sol test/TransferModesCombinations.t.sol src/SwapVM.sol && forge clean",
            "measure": false
          },
          "cold compile": {
            "command": "forge build",
            "dependsOn": ["reset files & cache"]
          },
          "edit & compile Solidity test with min deps: test/ProtocolFeeProviderMock.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> test/ProtocolFeeProviderMock.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity test with max deps: test/TransferModesCombinations.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> test/TransferModesCombinations.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity contract: src/SwapVM.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> src/SwapVM.sol && forge build",
            "dependsOn": ["cold compile"]
          }
        }
      },
      "warm compile": {
        "runs": 135,
        "command": "forge build",
        "dependsOn": ["cold compile"]
      },
      "test solidity": {
        "runs": 87,
        "command": "forge test",
        "dependsOn": ["cold compile"]
      }
    }
  }
}
