{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "Aave v4 fork compiled at solc 0.8.34, tracking solx and solc compile times. Compiles src only (--no-tests): the Foundry test contracts instantiate Hub/SpokeInstance, re-embedding them into legacy compilation jobs past the per-file via-IR overrides. EVM_DISABLE_MEMORY_SAFE_ASM_CHECK lets solx spill SpokeInstance's stack-too-deep despite the memory-unsafe assembly in the vendored OZ Arrays.sol (unannotated; upstream OZ marks those blocks memory-safe).",
  "tags": ["external-repo", "solx"],
  "repo": "anaPerezGhiglia/aave-v4",
  "commit": "f729aeff7cc61d576e8f89e818e05265ec9f65e9",
  "packageManager": "yarn",
  "submodules": true,
  "preinstall": "./preinstall.sh",
  "env": {
    "EVM_DISABLE_MEMORY_SAFE_ASM_CHECK": "1"
  },
  "defaultCommand": "npx hardhat compile --build-profile solx --no-tests",
  "benchmark": {
    "commands": {
      "prime compilers": {
        "runs": 1,
        "steps": {
          "assert fresh hardhat-slang-solx": {
            "command": "diff -rq .solx/expected-dist-src node_modules/@nomicfoundation/hardhat-slang-solx/dist/src",
            "measure": false
          },
          "download solc + solx and warm caches": {
            "command": "npx hardhat compile --no-tests && npx hardhat compile --build-profile solx --no-tests && npx hardhat clean",
            "measure": false
          },
          "warm forge solc cache": {
            "command": "FOUNDRY_SOLC=0.8.34 ./.foundry/forge build --skip 'tests/**' && ./.foundry/forge clean",
            "measure": false
          }
        }
      },
      "cold compile solx-0.1.8": {
        "runs": 2,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile --build-profile solx-0.1.8 --no-tests"
      },
      "cold compile solx-0.1.8 via-ir": {
        "runs": 2,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile --build-profile solx-0.1.8-via-ir --no-tests"
      },
      "cold compile solc": {
        "runs": 2,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile --no-tests"
      },
      "cold compile solc no-opt": {
        "runs": 2,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile --build-profile solc-no-opt --no-tests"
      },
      "cold compile solc via-ir": {
        "runs": 2,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile --build-profile solc-via-ir --no-tests"
      },
      "cold compile forge-1.7.1": {
        "runs": 2,
        "dependsOn": ["warm forge solc cache"],
        "prepare": "./.foundry/forge clean",
        "command": "FOUNDRY_SOLC=0.8.34 ./.foundry/forge build --skip 'tests/**' --offline"
      }
    }
  }
}
