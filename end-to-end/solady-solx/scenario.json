{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "Solady (assembly-heavy, solx's hardest case) compiled at solc 0.8.34, benchmarking solx against solc and forge. Mirrors upstream's post_osaka CI profile: the default profile targets paris + skip globs (inexpressible in Hardhat; paris predates solx's EVM floor), and preinstall removes the profile's five ext/ithaca skips for exact scope parity (246 sources on both tools). No solc no-opt cell: test/RedBlackTree.t.sol is stack-too-deep under optimizer-off legacy solc, and upstream only ships optimizer-on — the failure is the datum. Preinstall renames BlockHashLibTest#testBlockHash out of test discovery, identically for all three toolchains (2040 tests run everywhere): an EDR-generated fuzz input makes it revert under BOTH compilers with an identical counterexample — an EDR/test interaction, not a compiler divergence — and EDR pays the full per-run fuzz overhead even for a vm.skip'd test, so an in-code skip reclaims neither the exit code hygiene nor the ~7-9s it adds to every hardhat test cell.",
  "tags": ["external-repo", "solx"],
  "repo": "nebasuke/solady",
  "commit": "13d87ff27de01eb671dbee41b6d84ef98d5e2c32",
  "packageManager": "npm",
  "preinstall": "./preinstall.sh",
  "defaultCommand": "npx hardhat compile --build-profile solx",
  "benchmark": {
    "commands": {
      "prime compilers": {
        "runs": 1,
        "steps": {
          "assert fresh hardhat-slang-solx": {
            "command": "diff -rq .solx/expected-dist-src node_modules/@nomicfoundation/hardhat-slang-solx/dist/src",
            "measure": false
          },
          "download solc + solx and warm caches": {
            "command": "npx hardhat compile && npx hardhat compile --build-profile solx && npx hardhat clean",
            "measure": false
          },
          "warm forge solc cache": {
            "command": "FOUNDRY_PROFILE=post_osaka FOUNDRY_SOLC=0.8.34 ./.foundry/forge build && ./.foundry/forge clean",
            "measure": false
          }
        }
      },
      "cold compile solc": {
        "runs": 5,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile"
      },
      "cold compile solc via-ir": {
        "runs": 5,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile --build-profile solc-via-ir"
      },
      "cold compile solx-0.1.8": {
        "runs": 5,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile --build-profile solx-0.1.8"
      },
      "cold compile solx-0.1.8 via-ir": {
        "runs": 5,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat clean",
        "command": "npx hardhat compile --build-profile solx-0.1.8-via-ir"
      },
      "cold compile forge-1.7.1": {
        "runs": 5,
        "dependsOn": ["warm forge solc cache"],
        "prepare": "./.foundry/forge clean",
        "command": "FOUNDRY_PROFILE=post_osaka FOUNDRY_SOLC=0.8.34 ./.foundry/forge build --offline"
      },
      "warm test solx-0.1.8": {
        "runs": 3,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat compile --build-profile solx-0.1.8",
        "command": "npx hardhat test solidity --build-profile solx-0.1.8"
      },
      "warm test solx-0.1.8 via-ir": {
        "runs": 3,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat compile --build-profile solx-0.1.8-via-ir",
        "command": "npx hardhat test solidity --build-profile solx-0.1.8-via-ir"
      },
      "warm test solc": {
        "runs": 3,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat compile",
        "command": "npx hardhat test solidity"
      },
      "warm test solc via-ir": {
        "runs": 3,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat compile --build-profile solc-via-ir",
        "command": "npx hardhat test solidity --build-profile solc-via-ir"
      },
      "warm test forge-1.7.1": {
        "runs": 3,
        "dependsOn": ["warm forge solc cache"],
        "prepare": "FOUNDRY_PROFILE=post_osaka FOUNDRY_SOLC=0.8.34 ./.foundry/forge build --offline",
        "command": "FOUNDRY_PROFILE=post_osaka FOUNDRY_SOLC=0.8.34 FOUNDRY_FUZZ_SEED=0x736f6c782d746573742d657865637574696f6e2d6576616c756174696f6e2e31 ./.foundry/forge test --offline"
      },
      "warm compile solc": {
        "runs": 3,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat compile",
        "command": "npx hardhat compile"
      },
      "warm compile solx-0.1.8": {
        "runs": 3,
        "dependsOn": [
          "assert fresh hardhat-slang-solx",
          "download solc + solx and warm caches"
        ],
        "prepare": "npx hardhat compile --build-profile solx-0.1.8",
        "command": "npx hardhat compile --build-profile solx-0.1.8"
      },
      "warm compile forge-1.7.1": {
        "runs": 3,
        "dependsOn": ["warm forge solc cache"],
        "prepare": "FOUNDRY_PROFILE=post_osaka FOUNDRY_SOLC=0.8.34 ./.foundry/forge build --offline",
        "command": "FOUNDRY_PROFILE=post_osaka FOUNDRY_SOLC=0.8.34 ./.foundry/forge build --offline"
      }
    }
  }
}
