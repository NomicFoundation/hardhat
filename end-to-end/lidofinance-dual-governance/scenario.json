{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "Lido Dual Governance Smart contracts fork to Hardhat 3. MAINNET_FORK_BLOCK_NUMBER pins the mainnet fork so EDR's fork-db cache is reusable across runs.",
  "tags": ["external-repo"],
  "repo": "popescuoctavian/dual-governance",
  "commit": "ef72db01b9b69fddc7fefae9da160e465921ec42",
  "packageManager": "npm",
  "submodules": true,
  "preinstall": "./preinstall-foundry.sh",
  "env": {
    "MAINNET_RPC_URL": "${localEnv:ALCHEMY_URL}",
    "MAINNET_FORK_BLOCK_NUMBER": "26002900",
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}",
    "FOUNDRY_ISOLATE": "false",
    "FOUNDRY_LINT_LINT_ON_BUILD": "false"
  },
  "defaultCommand": "npx hardhat test solidity --grep=\"^(test_|testFuzz_)\"",
  "benchmark": {
    "commands": {
      "compile sequence": {
        "runs": 9,
        "steps": {
          "reset files & cache": {
            "command": "git checkout -- test/unit/scripts/launch/TimeConstraints.t.sol test/scenario/mainnet-launch.t.sol contracts/types/Timestamp.sol && forge clean",
            "measure": false
          },
          "cold compile": {
            "command": "forge build",
            "dependsOn": ["reset files & cache"]
          },
          "edit & compile Solidity test with min deps: test/unit/scripts/launch/TimeConstraints.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> test/unit/scripts/launch/TimeConstraints.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity test with max deps: test/scenario/mainnet-launch.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> test/scenario/mainnet-launch.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity contract: contracts/types/Timestamp.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> contracts/types/Timestamp.sol && forge build",
            "dependsOn": ["cold compile"]
          }
        }
      },
      "warm compile": {
        "runs": 249,
        "command": "forge build",
        "dependsOn": ["cold compile"]
      },
      "test solidity": {
        "runs": 9,
        "statistic": { "wall": "median" },
        "warmup": 1,
        "command": "forge test --match-test \"^(test_|testFuzz_)\"",
        "dependsOn": ["cold compile"]
      },
      "test solidity -vvv": {
        "runs": 9,
        "statistic": { "wall": "median" },
        "command": "forge test --match-test \"^(test_|testFuzz_)\" -vvv",
        "dependsOn": ["cold compile", "test solidity"]
      },
      "test solidity -vvvv": {
        "runs": 9,
        "statistic": { "wall": "median" },
        "command": "forge test --match-test \"^(test_|testFuzz_)\" -vvvv",
        "dependsOn": ["cold compile", "test solidity"]
      }
    }
  }
}
