{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "UniswapX contracts fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "popescuoctavian/UniswapX",
  "commit": "e4ed16b4e6894d36b7a19b985333dc254ebbf9d2",
  "packageManager": "npm",
  "submodules": true,
  "preinstall": "./preinstall-foundry.sh",
  "env": {
    "FOUNDRY_RPC_URL": "${localEnv:ALCHEMY_URL}",
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}",
    "FOUNDRY_ISOLATE": "false",
    "FOUNDRY_EVM_VERSION": "prague",
    "FOUNDRY_LINT_LINT_ON_BUILD": "false"
  },
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "compile sequence": {
        "runs": 9,
        "steps": {
          "reset files & cache": {
            "command": "git checkout -- test/lib/CosignerLib.t.sol test/reactors/V3DutchOrderReactor.t.sol src/base/ReactorStructs.sol && forge clean",
            "measure": false
          },
          "cold compile": {
            "command": "forge build",
            "dependsOn": ["reset files & cache"]
          },
          "edit & compile Solidity test with min deps: test/lib/CosignerLib.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> test/lib/CosignerLib.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity test with max deps: test/reactors/V3DutchOrderReactor.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> test/reactors/V3DutchOrderReactor.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity contract: src/base/ReactorStructs.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> src/base/ReactorStructs.sol && forge build",
            "dependsOn": ["cold compile"]
          }
        }
      },
      "warm compile": {
        "runs": 111,
        "command": "forge build",
        "dependsOn": ["cold compile"]
      },
      "test solidity": {
        "runs": 9,
        "warmup": 1,
        "command": "forge test",
        "dependsOn": ["cold compile"]
      },
      "test solidity -vvv": {
        "runs": 9,
        "command": "forge test -vvv",
        "dependsOn": ["cold compile", "test solidity"]
      },
      "test solidity -vvvv": {
        "runs": 9,
        "command": "forge test -vvvv",
        "dependsOn": ["cold compile", "test solidity"]
      }
    }
  }
}
