{
  "$schema": "../../scripts/end-to-end/schema/scenario.schema.json",
  "description": "Uniswap V4 core contracts fork to Hardhat 3.",
  "tags": ["external-repo"],
  "repo": "anaPerezGhiglia/uniswap-v4-core",
  "commit": "ab2b22eef19e0abe29d67420dde81b5d54455ae5",
  "packageManager": "pnpm",
  "env": {
    "pnpm_config_dangerously_allow_all_builds": "true",
    "PATH": "${localEnv:HOME}/.foundry/bin:${localEnv:PATH}"
  },
  "submodules": true,
  "preinstall": "./preinstall-foundry.sh",
  "defaultCommand": "npx hardhat test solidity",
  "benchmark": {
    "commands": {
      "compile sequence": {
        "runs": 9,
        "steps": {
          "reset files & cache": {
            "command": "git checkout -- test/libraries/BitMath.t.sol test/PoolManager.t.sol src/types/Currency.sol && forge clean",
            "measure": false
          },
          "cold compile": {
            "command": "forge build",
            "dependsOn": ["reset files & cache"]
          },
          "edit & compile Solidity test with min deps: test/libraries/BitMath.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> test/libraries/BitMath.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity test with max deps: test/PoolManager.t.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> test/PoolManager.t.sol && forge build",
            "dependsOn": ["cold compile"]
          },
          "edit & compile Solidity contract: src/types/Currency.sol": {
            "command": "printf \"\\n// hardhat benchmark edit\\n\" >> src/types/Currency.sol && forge build",
            "dependsOn": ["cold compile"]
          }
        }
      },
      "warm compile": {
        "runs": 153,
        "command": "forge build",
        "dependsOn": ["cold compile"]
      },
      "test solidity": {
        "runs": 21,
        "command": "forge test",
        "dependsOn": ["cold compile"]
      }
    }
  }
}
